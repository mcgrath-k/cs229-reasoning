{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build Addition Dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "dataset/build_addition_dataset.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Build Sudoku Dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "dataset/build_sudoku_dataset.py",
      "args": [
        "--output-dir", "data/sudoku-extreme-1k-aug-1000",
        "--subsample-size", "1000",
        "--num-aug", "1000"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Train Example Sudoku Model",
      "type": "debugpy",
      "request": "launch",
      "program": "pretrain.py",
      "env": {
        "OMP_NUM_THREADS": "8"
      },
      "args": [
        "data_path=data/sudoku-extreme-1k-aug-1000",
        "epochs=20000",
        "eval_interval=2000",
        "global_batch_size=384",
        "lr=7e-5",
        "puzzle_emb_lr=7e-5",
        "weight_decay=1.0",
        "puzzle_emb_weight_decay=1.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
    }
  ]
}