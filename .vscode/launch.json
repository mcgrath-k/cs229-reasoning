{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Build Addition Dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "dataset/build_addition_dataset.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Build Sudoku Dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "dataset/build_sudoku_dataset.py",
      "args": [
        "--output-dir", "data/sudoku-extreme-1k-aug-1000",
        "--subsample-size", "1000",
        "--num-aug", "1000"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Run pretraining addition",
      "type": "debugpy",
      "request": "launch",
      "program": "pretrain_simple.py",
      // removed omp num threads, not sure the use yet.
      "args": [
        "epochs=20000",
        "global_batch_size=384",
        "lr=5e-4",
        "weight_decay=1.0",
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
    },
    {
      "name": "Evaluate",
      "type": "debugpy",
      "request": "launch",
      "program": "evaluate.py",
      "console": "integratedTerminal",
      "justMyCode": false,
    }
  ]
}